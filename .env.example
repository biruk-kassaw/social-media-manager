# Transcription Provider: 'gemini' | 'openai' | 'groq' | 'mock'
TRANSCRIPTION_PROVIDER=gemini

# Google Gemini API Key (Recommended - fast, high quality transcription)
GEMINI_API_KEY=

# OpenAI API Key (Optional if using OpenAI whisper-1)
OPENAI_API_KEY=

# Groq API Key (Optional if using Groq whisper-large-v3)
GROQ_API_KEY=

# Application Settings
NEXT_PUBLIC_APP_NAME="CreatorStudio - Content Intelligence"
PORT=3000
